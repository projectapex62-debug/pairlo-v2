// ── API Routes (Express) ─────────────────────────────────────

const express = require('express');
const router  = express.Router();

// POST /api/checkout/intent
router.post('/intent', async (req, res) => {
  try {
    const { pairId, userId, guest } = req.body;
    if (!pairId || !userId) return res.status(400).json({ error: 'Missing required fields' });

    const result = await createPaymentIntent({ pairId, userId, guest });
    res.json(result);
  } catch (err) {
    console.error('Payment intent error:', err);
    res.status(500).json({ error: err.message });
  }
});

// POST /api/checkout/confirm
router.post('/confirm', async (req, res) => {
  try {
    const { bookingId, paymentIntentId, guest, payment } = req.body;
    if (!bookingId || !paymentIntentId) return res.status(400).json({ error: 'Missing required fields' });

    const result = await confirmBooking({ bookingId, paymentIntentId, guest, payment });
    await sendConfirmationEmail({ booking: result, guest });
    res.json(result);
  } catch (err) {
    console.error('Booking confirmation error:', err);
    res.status(500).json({ error: err.message });
  }
});

// GET /api/bookings/:id
router.get('/:id', async (req, res) => {
  try {
    const result = await pool.query(
      `SELECT b.*, p.pair_score,
              s.name as stay_name, s.total_price as stay_price,
              c.name as car_name, c.total_price as car_price
       FROM bookings b
       JOIN pairs p ON p.id = b.pair_id
       JOIN stays s ON s.id = p.stay_id
       JOIN cars  c ON c.id = p.car_id
       WHERE b.id = $1`,
      [req.params.id]
    );
    if (!result.rows.length) return res.status(404).json({ error: 'Booking not found' });
    res.json(result.rows[0]);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

module.exports = router;
module.exports.createPaymentIntent = createPaymentIntent;
module.exports.confirmBooking      = confirmBooking;